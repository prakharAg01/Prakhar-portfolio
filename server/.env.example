# Render Deployment Environment Variables Template

# Port for the server (Render will set this automatically)
PORT=5000

# Gmail credentials for Nodemailer (Mandatory)
# It is highly recommended to use a Gmail App Password
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Frontend URL (For CORS protection)
# Once your frontend is on Vercel, put its URL here (e.g., https://yourportfolio.vercel.app)
FRONTEND_URL=*
